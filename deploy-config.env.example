# cPanel SSH deploy — mobile API (backend-api)
# Copy to deploy-config.env and fill in (do not commit deploy-config.env).

SSH_HOST=servecafe.com
SSH_USER=servi5ne

# Laravel root on server (folder with artisan + public/)
# Sibling of web app repo: repositories/backend-api (not inside service_cafe/)
REMOTE_PATH=repositories/backend-api

# Public URL folder you created in cPanel (symlink target → public/)
REMOTE_PUBLIC_LINK=public_html/backend-mobile-api

SSH_PORT=22
# SSH_KEY=~/.ssh/id_rsa

# Install PHP deps on your Mac and upload vendor/ (recommended — cPanel SSH often has no composer in PATH)
LOCAL_VENDOR=1
# If you install deps on the server instead: LOCAL_VENDOR=0 and set one of:
# COMPOSER_BIN=/opt/cpanel/composer/bin/composer
