# cPanel SSH deploy — mobile API (backend-api)
# Copy to deploy-config.env and fill in (do not commit deploy-config.env).

SSH_HOST=servecafe.com
SSH_USER=servi5ne

# Laravel root on server (folder with artisan + public/)
# Monorepo on cPanel (same repo as web): repositories/service_cafe/backend-api
REMOTE_PATH=repositories/service_cafe/backend-api

# Public URL folder you created in cPanel (symlink target → public/)
REMOTE_PUBLIC_LINK=public_html/backend-mobile-api

SSH_PORT=22
# SSH_KEY=~/.ssh/id_rsa
