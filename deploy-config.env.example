# cPanel SSH deploy — mobile API (backend-api)
# Copy to deploy-config.env (gitignored). File Manager path must match REMOTE_PATH below.

SSH_HOST=servecafe.com
SSH_USER=servi5ne

# Laravel root ON THE SERVER (artisan + public/ live here).
# cPanel File Manager: Home → repositories → backend-api
# Full path: /home4/servi5ne/repositories/backend-api
REMOTE_PATH=repositories/backend-api

# Public URL folder (symlink → repositories/backend-api/public)
# URL: https://servecafe.com/backend-mobile-api/api
REMOTE_PUBLIC_LINK=public_html/backend-mobile-api

SSH_PORT=22
# SSH_KEY=~/.ssh/id_rsa

# Install PHP deps on Mac and upload vendor/ (recommended on cPanel)
LOCAL_VENDOR=1
# Server-side composer instead: LOCAL_VENDOR=0
# COMPOSER_BIN=/opt/cpanel/composer/bin/composer
